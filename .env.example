# Copy this file to .env for local development.
# Never commit real API keys or passwords.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
APP_PASSWORD=
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GPT_ACTION_API_KEY=
BASE_URL=http://127.0.0.1:8000
NAVER_REDIRECT_URI=http://127.0.0.1:8000/oauth/naver/callback

# Optional. If empty, local SQLite is used.
# For hosted deployment, use the Supabase Session pooler URL.
DATABASE_URL=
